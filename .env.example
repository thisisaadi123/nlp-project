# Copy to .env and fill in. Never commit .env.

# Sarvam: translation drafts, the translator model, voice lines, speech-to-text for players' takes.
# Backups (e.g. teammates' accounts) are used in order once a key runs out of credits.
SARVAM_API_KEY=
SARVAM_API_KEY_2=
SARVAM_API_KEY_3=
SARVAM_API_KEY_4=

# Groq: video captions (vision model); gpt-oss for translation only if llm.translator is "gpt-oss".
GROQ_API_KEY=
GROQ_API_KEY_2=

# Gemini: backup LLM, clip pre-labels, the blind translation judge.
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# Hugging Face: gated models for step 3 (pyannote, IndicConformer) and datasets (Rasa).
HF_TOKEN=

# Optional: Cerebras serves the same gpt-oss-120b as Groq with larger limits.
CEREBRAS_API_KEY=
